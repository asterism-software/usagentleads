# Resend
RESEND_API_KEY=
# Required for promotional email footers (street address, registered PO box,
# or registered private mailbox). Transactional email does not use this value.
EMAIL_POSTAL_ADDRESS=

# Legacy Hetzner leads source. Retain only for migration verification, rollback,
# and disabled ingest tooling during the stabilization window; the web app no
# longer reads these values after the Supabase cutover.
LEADS_REST_KEY=
LEADS_REST_URL=

# Site URL
NEXT_PUBLIC_APP_URL=

# Stripe (public Price IDs live beside the plans in PlanGroups.tsx)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Signed cron and marketing-unsubscribe links
CRON_SECRET=
UNSUBSCRIBE_SECRET=

# Send Email
SEND_EMAIL_HOOK_SECRET=

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# IndexNow
INDEXNOW_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
